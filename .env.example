# ── Firebase (Firebase Console → Project settings → Your apps → Web app) ──
# Bunlar açıq (public) açarlardır. Boş qalsa sayt "demo rejimində" işləyir:
# məzmun lib/seed.ts-dən gəlir, admin dəyişiklikləri yalnız brauzerdə saxlanır.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore kolleksiyalarının prefiksi. DataTech saytı ilə eyni Firebase-də
# məlumatlar qarışmasın deyə defolt "hub_" (hub_events, hub_team ...).
NEXT_PUBLIC_FS_PREFIX=hub_

# Baş adminlər (vergüllə). Firestore-da da hub_admins/{email} (role: "super")
# və ya DataTech-in admins/{email} sənədi olmalıdır, yoxsa qaydalar yazmağa icazə vermir.
NEXT_PUBLIC_ADMIN_EMAILS=

# Saytın əsas ünvanı (SEO, sitemap, OG üçün), məs. https://bmu-icmalar.vercel.app
NEXT_PUBLIC_SITE_URL=
