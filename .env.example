# Firebase (Firebase Console → Project settings → Your apps → Web app). Bunlar açıq açarlardır.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Yalnız bu domenin e-poçtları daxil ola bilər (məs. beu.edu.az). Boş qalsa hamı.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=
# Admin panelini görənlər (vergüllə). Firestore-da da admins/{email} sənədi yaradılmalıdır.
NEXT_PUBLIC_ADMIN_EMAILS=

# AI köməkçi (gizli, yalnız Vercel-də saxla)
ANTHROPIC_API_KEY=
CHAT_DAILY_LIMIT=20
CHAT_COOKIE_SECRET=
