rules_version = '2';
// DataTech Firestore qaydaları + BMU İcmaları ortaq saytı (hub_ kolleksiyaları, faylın sonunda).
// Admin: `admins/{email}` sənədi olan istifadəçi (Firebase Console-dan əl ilə yaradılır).
// BMU domeni: aşağıdakı DOMAIN dəyərini real domenlə əvəz et.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admin: yalnız `admins/{email}` sənədi olan və e-poçtu təsdiqlənmiş hesab. `admins` kolleksiyasına heç kim
    // saytdan yaza bilməz, yalnız Firebase Console-dan. Orada yalnız bir sənəd (Yuranın e-poçtu) olmalıdır.
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true
                              && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)); }
    // BMU tələbəsi (@std.beu.edu.az) və ya admin (admin başqa domendən də ola bilər).
    function isBmu() { return signedIn() && (isAdmin() || (request.auth.token.email_verified == true
                              && request.auth.token.email.matches('.*@std[.]beu[.]edu[.]az$'))); } // DOMAIN
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /admins/{email} { allow read: if isAdmin(); allow write: if false; }

    // Şəxsi profil (e-poçt, telefon): yalnız sahibi və admin.
    match /users/{uid} { allow read, write: if isOwner(uid) && isBmu() || isAdmin(); }

    // İctimai profil (reytinq üçün): hamı oxuyur. Üzv yalnız 0 xalla yarada bilər, adını dəyişə bilər; xal/nişanı yalnız admin.
    match /members/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && isBmu() && request.resource.data.points == 0;
      allow update: if isAdmin() || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points', 'badges']));
      allow delete: if isAdmin();
    }

    match /activities/{id}   { allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); allow write: if isAdmin(); }
    match /certificates/{id} { allow read: if true; allow write: if isAdmin(); }
    match /careers/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /stats/{id}        { allow read: if true; allow write: if isAdmin(); }

    // Tədbir qeydiyyatı: sənəd id-si "<slug>_<uid>".
    match /registrations/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin() || (isBmu() && id.matches('.*_' + request.auth.uid) && request.resource.data.uid == request.auth.uid);
    }
    match /ratings/{id}     { allow read: if isAdmin(); allow create, update: if request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5; }
    match /quizAnswers/{id} { allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); allow create: if isBmu() && request.resource.data.uid == request.auth.uid; }

    // Formalar: hamı göndərə bilər (rəy anonim ola bilər), yalnız admin oxuyur.
    match /feedback/{id}     { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /messages/{id}     { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /applications/{id} { allow create: if isBmu(); allow read, update, delete: if isAdmin(); }
    match /bookings/{id}     { allow create: if isBmu(); allow read, update, delete: if isAdmin(); }

    // Layihələr: üzv göndərir (təsdiqsiz), hamı yalnız təsdiqlənmişləri görür.
    match /projects/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if isBmu() && request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }
    // Komanda axtar: üzvlər yazır, hamı oxuyur, sahibi silə bilər.
    match /teamPosts/{id} {
      allow read: if true;
      allow create: if isBmu() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // Analitika: hər ziyarətçi yalnız yeni hadisə yaza bilər (dəyişmək/oxumaq olmaz). Yalnız admin oxuyur.
    match /events/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(['type','path','label','target','value','text','code','vid','sid','uid','src','dev','os','br','lang','sw','day','hour','createdAt'])
                    && request.resource.data.type is string && request.resource.data.type.size() <= 30
                    && request.resource.data.path is string && request.resource.data.path.size() <= 300
                    && request.resource.data.vid is string && request.resource.data.vid.size() <= 40
                    && request.resource.data.createdAt == request.time
                    && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
                    && (!('text' in request.resource.data) || request.resource.data.text.size() <= 300);
    }
    // Aktivlik reytinqi: xam data yalnız admin üçündür və heç vaxt silinmir (illik analiz üçün).
    match /roster/{email}  { allow read, create, update: if isAdmin(); allow delete: if false; }
    match /aliases/{key}   { allow read, create, update: if isAdmin(); allow delete: if false; }
    match /imports/{id}    { allow read, create, update: if isAdmin(); allow delete: if false; }
    match /scores/{month}  { allow read, create, update: if isAdmin(); allow delete: if false; }
    // Check-in sessiyaları: hamı oxuyur (QR səhifəsi üçün), yalnız admin yaradır/açıb-bağlayır.
    match /sessions/{code} { allow read: if true; allow create, update: if isAdmin(); allow delete: if false; }
    // Check-in: BMU üzvü öz adına, açıq sessiyaya yalnız bir dəfə yazır. Dəyişmək/silmək olmaz.
    match /checkins/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isBmu() && id == request.resource.data.code + '_' + request.auth.uid
                    && request.resource.data.keys().hasOnly(['code','uid','email','kind','day','updatedAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email.lower()
                    && request.resource.data.updatedAt == request.time
                    && get(/databases/$(database)/documents/sessions/$(request.resource.data.code)).data.open == true;
      allow update, delete: if false;
    }
    // Gizli QR linkləri: hamı oxuyur (yönləndirmə üçün), skan sayğacı yalnız +1 artırıla bilər.
    match /links/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hits', 'updatedAt'])
                                     && request.resource.data.hits == resource.data.hits + 1);
    }

    // =====================================================================
    // BMU İCMALARI ORTAQ SAYTI (hub_ kolleksiyaları). DataTech-in qaydalarına toxunulmur.
    // Baş admin: DataTech-in admins/{email} sənədi VƏ YA hub_admins/{email} (role != "community").
    // İcma admini: hub_admins/{email} {role: "community", community: "devora|shellshock|datatech|innotech"}.
    // =====================================================================
    function hubEmail() { return request.auth.token.email.lower(); }
    function hubAdminPath() { return /databases/$(database)/documents/hub_admins/$(hubEmail()); }
    function hubIsAdmin() { return signedIn() && (isAdmin() || exists(hubAdminPath())); }
    function hubIsSuper() { return signedIn() && (isAdmin() || (exists(hubAdminPath()) && get(hubAdminPath()).data.get('role', 'super') != 'community')); }
    function hubMine() { return get(hubAdminPath()).data.get('community', '-'); }
    // Bu icmanı redaktə edə bilərmi? ("all" yalnız baş admin üçündür.)
    function hubCan(c) { return hubIsSuper() || (hubIsAdmin() && c == hubMine()); }
    function hubWriteScoped() {
      return hubIsSuper() || (
        hubIsAdmin()
        && (request.resource == null || hubCan(request.resource.data.get('community', '-')))
        && (resource == null || hubCan(resource.data.get('community', '-'))));
    }
    function hubStr(d, k, min, max) { return d.get(k, '') is string && d.get(k, '').size() >= min && d.get(k, '').size() <= max; }
    function hubScope(v) { return v in ['all', 'devora', 'shellshock', 'datatech', 'innotech']; }

    match /hub_admins/{email} {
      allow read: if signedIn() && (hubEmail() == email || hubIsSuper());
      allow write: if hubIsSuper();
    }
    match /hub_site/{id} { allow read: if true; allow write: if hubIsSuper(); }
    match /hub_communities/{id} {
      allow read: if true;
      allow create, delete: if hubIsSuper();
      allow update: if hubCan(id);
    }
    match /hub_events/{id}   { allow read: if true; allow write: if hubWriteScoped(); }
    match /hub_team/{id}     { allow read: if true; allow write: if hubWriteScoped(); }
    match /hub_mentors/{id}  { allow read: if true; allow write: if hubWriteScoped(); }
    match /hub_partners/{id} { allow read: if true; allow write: if hubWriteScoped(); }
    match /hub_faqs/{id}     { allow read: if true; allow write: if hubWriteScoped(); }
    // Şəkillər (Storage aktiv olmayanda Firestore-da saxlanılır, ~700 KB-a qədər).
    match /hub_media/{id} {
      allow read: if true;
      allow create: if hubIsAdmin() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if hubIsAdmin();
    }

    // Formalar: hər kəs göndərə bilər (sayt /api/forms vasitəsilə), ölçü və sahələr yoxlanılır.
    match /hub_problems/{id} {
      allow read: if resource.data.public == true || hubIsAdmin();
      allow create: if request.resource.data.keys().hasOnly(['title', 'description', 'affected', 'current', 'category', 'community', 'name', 'contact', 'status', 'public', 'createdAt'])
        && hubStr(request.resource.data, 'title', 1, 160) && hubStr(request.resource.data, 'description', 1, 1500)
        && hubStr(request.resource.data, 'affected', 0, 300) && hubStr(request.resource.data, 'current', 0, 300)
        && hubStr(request.resource.data, 'category', 0, 30) && hubStr(request.resource.data, 'name', 0, 80)
        && hubStr(request.resource.data, 'contact', 0, 120) && hubScope(request.resource.data.community)
        && request.resource.data.status == 'pending' && request.resource.data.public == false;
      allow update: if hubIsSuper() || (hubIsAdmin() && resource.data.community in ['all', hubMine()]);
      allow delete: if hubIsSuper() || (hubIsAdmin() && resource.data.community == hubMine());
    }
    match /hub_questions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'name', 'contact', 'question', 'category', 'community', 'answered', 'createdAt'])
        && request.resource.data.kind in ['question', 'contact'] && hubStr(request.resource.data, 'question', 1, 1000)
        && hubStr(request.resource.data, 'name', 0, 80) && hubStr(request.resource.data, 'contact', 0, 120)
        && hubStr(request.resource.data, 'category', 0, 30) && hubScope(request.resource.data.community)
        && request.resource.data.answered == false;
      allow read: if hubIsAdmin();
      allow update: if hubIsSuper() || (hubIsAdmin() && resource.data.community in ['all', hubMine()]);
      allow delete: if hubIsSuper() || (hubIsAdmin() && resource.data.community == hubMine());
    }
    match /hub_collabs/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'name', 'org', 'contact', 'message', 'community', 'answered', 'createdAt'])
        && request.resource.data.type in ['community', 'sponsor', 'mentor', 'company']
        && hubStr(request.resource.data, 'name', 1, 80) && hubStr(request.resource.data, 'contact', 1, 120)
        && hubStr(request.resource.data, 'message', 1, 1000) && hubStr(request.resource.data, 'org', 0, 120)
        && hubScope(request.resource.data.community) && request.resource.data.answered == false;
      allow read: if hubIsAdmin();
      allow update: if hubIsSuper() || (hubIsAdmin() && resource.data.community in ['all', hubMine()]);
      allow delete: if hubIsSuper() || (hubIsAdmin() && resource.data.community == hubMine());
    }
    match /hub_registrations/{id} {
      allow create: if request.resource.data.keys().hasOnly(['eventId', 'eventSlug', 'name', 'contact', 'group', 'note', 'createdAt'])
        && hubStr(request.resource.data, 'eventId', 1, 80) && hubStr(request.resource.data, 'eventSlug', 0, 80)
        && hubStr(request.resource.data, 'name', 1, 80) && hubStr(request.resource.data, 'contact', 1, 120)
        && hubStr(request.resource.data, 'group', 0, 80) && hubStr(request.resource.data, 'note', 0, 300);
      allow read, update, delete: if hubIsAdmin();
    }
  }
}
